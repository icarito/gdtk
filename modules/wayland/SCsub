#!/usr/bin/env python

Import("env")
Import("env_modules")

env_wayland = env_modules.Clone()

env_wayland.Prepend(CPPPATH=[Dir(".").abspath])

# wlr_layer_shell_v1.h incluye el header del protocolo, que wlroots no instala: se genera
# (sólo enums/declaraciones; el código del protocolo ya está en libwlroots).
import os
import subprocess

_here = Dir(".").srcnode().abspath
_xml = os.path.join(_here, "protocols", "wlr-layer-shell-unstable-v1.xml")
_hdr = os.path.join(_here, "wlr-layer-shell-unstable-v1-protocol.h")
if not os.path.exists(_hdr) or os.path.getmtime(_hdr) < os.path.getmtime(_xml):
    subprocess.check_call(["wayland-scanner", "server-header", _xml, _hdr])

# wlr_virtual_pointer (cursor nativo del host, ver remote_pointer.c): a diferencia de
# layer-shell, libwlroots no exporta las interfaces del cliente, así que se genera también
# el código (interfaces + marshalling) y se compila acá.
_vp_xml = os.path.join(_here, "protocols", "wlr-virtual-pointer-unstable-v1.xml")
_vp_hdr = os.path.join(_here, "wlr-virtual-pointer-unstable-v1-protocol.h")
_vp_src = os.path.join(_here, "wlr-virtual-pointer-unstable-v1-protocol.c")
if not os.path.exists(_vp_hdr) or os.path.getmtime(_vp_hdr) < os.path.getmtime(_vp_xml):
    subprocess.check_call(["wayland-scanner", "client-header", _vp_xml, _vp_hdr])
if not os.path.exists(_vp_src) or os.path.getmtime(_vp_src) < os.path.getmtime(_vp_xml):
    subprocess.check_call(["wayland-scanner", "private-code", _vp_xml, _vp_src])

env_wayland.Append(CPPDEFINES=["WLR_USE_UNSTABLE"])
env_wayland.ParseConfig("pkg-config wlroots-0.20 libeis-1.0 libsystemd --cflags")

# Las libs van al env del link final (el módulo es una librería estática).
# GL/GLES se resuelven con eglGetProcAddress: solo se linkea egl.
# libeis + sd-bus (libsystemd): input remoto y backend del portal RemoteDesktop (remote_input.cpp).
# wayland-client: puntero del host (remote_pointer.c) y cursor nativo del compositor anfitrión.
env.ParseConfig("pkg-config wlroots-0.20 wayland-server wayland-client xkbcommon pixman-1 libeis-1.0 libsystemd --libs")
env.ParseConfig("pkg-config egl --libs")

env_wayland.add_source_files(env.modules_sources, "*.c")
env_wayland.add_source_files(env.modules_sources, "*.cpp")
