; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="gdtk shell"
run/main_scene="res://main.tscn"
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=16000

[audio]

driver="Dummy"
output_latency=500

[autoload]

DebugHud="*res://addons/debug_hud/debug_hud.gd"
Host="*res://host.gd"

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

quality/driver/driver_name="GLES3"
quality/driver/fallback_to_gles2=true
; ImGui emite un solo lote por vista: el Vecindario con muchas redes pasaba los 16384 vértices
; por defecto ("poly has too many indices") y no dibujaba nada.
batching/parameters/batch_buffer_size=65535

environment/default_clear_color=Color( 0.1, 0.1, 0.12, 1 )

[physics]

; El shell no usa física: 60 pasos/s eran trabajo puro en reposo.
common/physics_fps=10
