<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<!--
  Acción dedicada al helper root-owned /usr/libexec/gdtk-set-governor
  (SPEC-power-governor). Sólo una sesión local activa obtiene autorización
  implícita; allow_any/allow_inactive quedan en no y no se habilita allow_gui.
  pkexec no valida argumentos: el helper los valida por sí mismo.
-->
<policyconfig>
  <vendor>gdtk</vendor>
  <vendor_url>https://github.com/gdtk</vendor_url>
  <action id="org.gdtk.governor.set">
    <description>Cambiar el governor de CPU</description>
    <message>Se requiere autorización para cambiar el governor de CPU</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/gdtk-set-governor</annotate>
  </action>
</policyconfig>
