#!/bin/sh
# Preflight de un contenido versionado: compila todos los .gd y verifica que el
# binario tenga los modulos esperados. Se corre antes de promover una version
# (lo llama gdtk-version snapshot) y a mano para diagnosticar un arranque roto.
# Uso: gdtk-preflight [<content-dir>]
set -eu

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
BASE="$(cd "$SELF_DIR/.." && pwd)"
STORE="${GDTK_STORE:-${XDG_DATA_HOME:-$HOME/.local/share}/gdtk}"
CONTENT="${1:-}"
[ -n "$CONTENT" ] || CONTENT="$( [ -L "$STORE/current" ] && readlink -f "$STORE/current" || true )"
[ -n "$CONTENT" ] || CONTENT="${GDTK_HOME:-$BASE}"

die() { echo "gdtk-preflight: $*" >&2; exit 3; }

[ -f "$CONTENT/shell/project.godot" ] || die "no encuentro $CONTENT/shell/project.godot"

GODOT="${GDTK_GODOT:-}"
if [ -z "$GODOT" ]; then
	if [ -x "$BASE/bin/godot-gdtk" ]; then
		GODOT="$BASE/bin/godot-gdtk"
	else
		GODOT="/home/icarito/Proyectos/godot3-box3d/godot-dev/bin/godot.frt.opt.debug.x86_64.gdtklite"
	fi
fi
[ -x "$GODOT" ] || die "binario no ejecutable: $GODOT"

# Por ssh no hay display: el binario FRT/SDL aborta en SDL_Init aunque vaya --no-window.
# Con el driver offscreen compila todo pero aborta al salir (rc 134), así que el
# veredicto sale del resumen "preflight: N scripts, M fallas" y no del rc.
# SIEMPRE offscreen: es un chequeo de compilación headless. Si hereda el
# WAYLAND_DISPLAY de una sesión viva, el binario intenta abrir OTRA ventana; si la
# sesión no tiene salidas (p. ej. el seat lo tomó GDM), SDL_Init falla con "did not
# add any displays", el preflight no llega a correr y el supervisor reintenta autogood
# en un bucle apretado. Offscreen lo desacopla de la sesión gráfica.
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-offscreen}"
rc=0
out="$("$GODOT" --no-window --path "$CONTENT/shell" -s "$SELF_DIR/gdtk-preflight.gd" 2>&1)" || rc=$?
printf '%s\n' "$out" | grep '^FAIL' || true
printf '%s\n' "$out" | grep '^preflight:' || true
summary="$(printf '%s\n' "$out" | grep '^preflight:' || true)"
case "$summary" in
	*", 0 fallas") ;;
	"") die "el preflight no llegó a correr (rc=$rc): $(printf '%s\n' "$out" | tail -2 | tr '\n' ' ')" ;;
	*) die "scripts no compilan (rc=$rc)" ;;
esac

# Fase 3 pineara el runtime desde un manifiesto; por ahora solo avisamos.
for sym in ImGuiCanvas SlugVector2D; do
	grep -q "$sym" "$GODOT" 2>/dev/null || echo "gdtk-preflight: WARN falta $sym en $GODOT" >&2
done
exit 0
