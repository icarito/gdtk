#!/bin/sh
# DEPRECADO: la sesión por defecto es sway (cage ya no se soporta: sin lápiz/touch).
# Este nombre se conserva como alias para entradas .desktop antiguas.
# El autostart (polkit/keyring/notificaciones, session/autostart.sh) lo hace la
# sesión sway a la que se delega.
exec "$(dirname "$0")/gdtk-session-sway" "$@"
# --- código cage anterior (no se ejecuta) ---
HERE="$(cd "$(dirname "$0")/.." && pwd)"
. "$HERE/session/keyboard.sh"
. "$HERE/session/portal.sh"   # XDG_CURRENT_DESKTOP=gdtk para el portal RemoteDesktop
export GDTK_SESSION=wayland
# Instalado: binario junto al shell (bin/godot-gdtk); en desarrollo: el build del árbol de Godot.
if [ -z "$GDTK_GODOT" ]; then
	GDTK_GODOT="$HERE/bin/godot-gdtk"
	[ -x "$GDTK_GODOT" ] || GDTK_GODOT=/home/icarito/Proyectos/godot3-box3d/godot-dev/bin/godot.frt.opt.debug.x86_64.gdtklite
fi
# Dentro de cage hay Xwayland: sin esto SDL puede elegir X11/GLX y pedir GL 3.3 (GLXBadFBConfig en GPUs viejas).
# Sin audio ni joysticks en el shell: sus hilos despiertan la CPU sin uso (el shell las vacía para las apps).
export SDL_AUDIODRIVER=dummy SDL_JOYSTICK_HIDAPI=0 SDL_HIDAPI_LIBUSB=0
export SDL_VIDEODRIVER=wayland
# Sin libdecor: cage no dibuja barras y SDL reservaba 37 px para una que nunca aparecía (franja negra).
export SDL_VIDEO_WAYLAND_ALLOW_LIBDECOR=0
# El shell usa GLES2 por defecto (project.godot); GDTK_VIDEO_DRIVER=GLES3 para forzar el otro.
# El supervisor relanza el shell si se cae (ver gdtk-supervisor): cage sigue vivo mientras él viva.
exec cage -s -- "$HERE/session/gdtk-supervisor" "$GDTK_GODOT" ${GDTK_VIDEO_DRIVER:+--video-driver "$GDTK_VIDEO_DRIVER"} --fullscreen --path "$HERE/shell" "$@"
