#!/bin/sh
# Rotación de pantalla para gdtk: sway (swaymsg) o X11 (xrandr), según la sesión.
#
#   gdtk-rotate next|right     rota 90° en sentido horario (normal -> 90 -> 180 -> 270)
#   gdtk-rotate left           rota 90° en sentido antihorario (normal -> 270 -> 180 -> 90)
#   gdtk-rotate set <t>        fija el transform: normal | 90 | 180 | 270
#   gdtk-rotate auto           daemon: sigue la orientación del equipo
#   gdtk-rotate hold [on|off|toggle]
#                              pausa/reactiva el modo auto (para leer acostado)
#   gdtk-rotate status         backend, transform actual, orientación y hold
#
# Backend por entorno: SWAYSOCK (sway) o DISPLAY con xrandr (X11). La orientación la
# publica iio-sensor-proxy por D-Bus (net.hadess.SensorProxy.AccelerometerOrientation),
# que ya resuelve la matriz de montaje del sensor.
#
# ponytail X11: la ventana del shell se dimensiona una vez al arrancar
# (gdtk-session-x11) y sin window manager no se redimensiona sola al rotar, así que
# en X11 la rotación se aplica al output pero el shell mantiene su tamaño.

run_dir="${XDG_RUNTIME_DIR:-/tmp}/gdtk"
mkdir -p "$run_dir" 2>/dev/null || true
hold_file="$run_dir/rotate.hold"
pid_file="$run_dir/rotate.pid"
sock_file="$run_dir/rotate.sock"   # clave de sesión del daemon vivo (ver auto_loop)

_backend() {
	if command -v swaymsg >/dev/null 2>&1 && [ -n "${SWAYSOCK:-}" ] && [ -S "$SWAYSOCK" ]; then
		printf 'sway'
	elif command -v xrandr >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ] && xrandr --query >/dev/null 2>&1; then
		printf 'x11'
	else
		printf 'none'
	fi
}
_ok() { [ "$(_backend)" != "none" ]; }
_session_key() { printf '%s' "${SWAYSOCK:-}${DISPLAY:-}"; }

_x11_output() { xrandr --query 2>/dev/null | awk '/ connected/{print $1; exit}'; }
_x11_rot_name() { # transform -> token xrandr
	case "$1" in normal) echo normal ;; 90) echo right ;; 180) echo inverted ;; 270) echo left ;; esac
}
_x11_transform_name() { # token xrandr -> transform
	case "$1" in normal) echo normal ;; right) echo 90 ;; inverted) echo 180 ;; left) echo 270 ;; esac
}

set_transform() {
	case "$(_backend)" in
		sway) swaymsg output '*' transform "$1" >/dev/null 2>&1 ;;
		x11)  xrandr --output "$(_x11_output)" --rotate "$(_x11_rot_name "$1")" >/dev/null 2>&1 ;;
	esac
}

# Devuelve normal|90|180|270. En X11, xrandr imprime la rotación actual como palabra
# entre la geometría y la lista "(normal left ...)"; sin rotar no la imprime.
current_transform() {
	case "$(_backend)" in
		sway)
			swaymsg -t get_outputs -r 2>/dev/null \
				| jq -r 'map(select(.focused))[0].transform // .[0].transform // "normal"' 2>/dev/null ;;
		x11)
			_o="$(_x11_output)"
			[ -n "$_o" ] || return
			_tok="$(xrandr --query 2>/dev/null | awk -v o="$_o" '
				$1 == o {
					for (i = 1; i <= NF; i++) {
						if ($i ~ /^[0-9]+x[0-9]+\+/) {
							if ($(i+1) ~ /^(normal|left|right|inverted)$/) { print $(i+1); exit }
						}
					}
					print "normal"; exit
				}')"
			_x11_transform_name "$_tok" ;;
	esac
}

cycle() { # cw|ccw
	case "$(current_transform):$1" in
		normal:cw|0:cw)   set_transform 90 ;;
		90:cw)            set_transform 180 ;;
		180:cw)           set_transform 270 ;;
		270:cw)           set_transform normal ;;
		normal:ccw|0:ccw) set_transform 270 ;;
		90:ccw)           set_transform normal ;;
		180:ccw)          set_transform 90 ;;
		270:ccw)          set_transform 180 ;;
		*)                set_transform 90 ;;
	esac
}

orientation() {
	busctl --system get-property net.hadess.SensorProxy /net/hadess/SensorProxy \
		net.hadess.SensorProxy AccelerometerOrientation 2>/dev/null \
		| sed -e 's/^s //' -e 's/^"//' -e 's/"$//'
}

orientation_transform() {
	case "$1" in
		normal)    printf 'normal' ;;
		right-up)  printf '90' ;;
		bottom-up) printf '180' ;;
		left-up)   printf '270' ;;
	esac
}

held() { [ -f "$hold_file" ]; }

auto_loop() {
	# Instancia única POR SESIÓN: el pidfile sólo bloquea si el daemon vivo es de la
	# misma sesión (misma clave SWAYSOCK/DISPLAY).
	_key="$(_session_key)"
	if [ -f "$pid_file" ]; then
		_old="$(cat "$pid_file" 2>/dev/null)"
		_oldsock="$(cat "$sock_file" 2>/dev/null)"
		if [ -n "$_old" ] && kill -0 "$_old" 2>/dev/null; then
			[ "$_oldsock" = "$_key" ] && exit 0
			kill "$_old" 2>/dev/null
			sleep 0.2
		fi
	fi
	echo $$ >"$pid_file"
	printf '%s' "$_key" >"$sock_file"
	# El backend puede tardar en estar listo (sway/X11 arrancando): esperar un poco.
	_n=0
	while ! _ok && [ "$_n" -lt 300 ]; do sleep 0.2; _n=$((_n + 1)); done
	_ok || { rm -f "$pid_file" "$sock_file"; echo "gdtk-rotate: sin backend (sway/x11), salgo" >&2; exit 0; }

	busctl --system call net.hadess.SensorProxy /net/hadess/SensorProxy \
		net.hadess.SensorProxy ClaimAccelerometer >/dev/null 2>&1 || true
	trap 'busctl --system call net.hadess.SensorProxy /net/hadess/SensorProxy \
		net.hadess.SensorProxy ReleaseAccelerometer >/dev/null 2>&1; rm -f "$pid_file" "$sock_file"; exit 0' INT TERM

	_dead=0
	_last=""
	while :; do
		# Backend perdido (compositor/X muertos): salir para no girar contra nada.
		if ! _ok; then
			_dead=$((_dead + 1))
			if [ "$_dead" -ge 3 ]; then
				busctl --system call net.hadess.SensorProxy /net/hadess/SensorProxy \
					net.hadess.SensorProxy ReleaseAccelerometer >/dev/null 2>&1 || true
				rm -f "$pid_file" "$sock_file"
				echo "gdtk-rotate: backend perdido, salgo" >&2
				exit 0
			fi
		else
			_dead=0
			_o="$(orientation)"
			_t="$(orientation_transform "$_o")"
			# Se compara con la rotación REAL, no con la última que aplicó este daemon:
			# un giro desde otro lado (atajo de sway, otra herramienta) dejaba la pantalla
			# desfasada del sensor hasta mover el equipo. Un giro manual que deba quedarse
			# pone `hold` (menú del anillo y atajo de sway).
			if [ -n "$_t" ] && ! held && [ "$(current_transform)" != "$_t" ]; then
				set_transform "$_t"
				[ "$_t" != "$_last" ] && echo "gdtk-rotate: $_o -> $_t" >&2
				_last="$_t"
			fi
		fi
		sleep 1
	done
}

case "${1:-status}" in
	next|right) cycle cw ;;
	left)       cycle ccw ;;
	set)
		case "${2:-}" in
			normal|90|180|270) set_transform "${2}" ;;
			*) echo "uso: gdtk-rotate set normal|90|180|270" >&2; exit 2 ;;
		esac ;;
	auto)  auto_loop ;;
	hold)
		case "${2:-toggle}" in
			on)     : >"$hold_file" ;;
			off)    rm -f "$hold_file" ;;
			toggle) if held; then rm -f "$hold_file"; else : >"$hold_file"; fi ;;
			*) echo "uso: gdtk-rotate hold [on|off|toggle]" >&2; exit 2 ;;
		esac ;;
	status)
		printf 'backend: %s\ntransform: %s\norientation: %s\nhold: %s\n' \
			"$(_backend)" "$(current_transform)" "$(orientation)" \
			"$(held && echo on || echo off)" ;;
	*) echo "uso: gdtk-rotate {next|right|left|set <t>|auto|hold [on|off|toggle]|status}" >&2; exit 2 ;;
esac
