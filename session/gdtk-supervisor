#!/bin/sh
# Vigila el shell: lo relanza si se cae y, si se cae seguido, lo arranca a prueba de fallos
# (GLES2, sin restaurar estado). Uso: gdtk-supervisor <godot> [args...]
# Salida 0 = el usuario salio (termina la sesion); 75 = reinicio pedido (MCP gdtk_restart_shell).
# Logs en ~/.local/state/gdtk: shell.log (corrida actual), shell.prev.log, crash-*.log.
#
# Versionado: lo que corre es SIEMPRE el arbol vivo (--path original, ~/gdtk/shell):
# sincronizar basta, no hay snapshot que activar. El store (gdtk-version) es solo una red
# de seguridad automatica: solo se guarda last_good_content cuando el heartbeat
# semantico del shell acredita progreso (C2, SPEC-session-continuity): PID vivo, heartbeat
# del PID correcto, `sequence` avanzando y `reload=ready`. Si el shell vivo se cae 2 veces
# seguidas al arrancar, se usa last_good hasta el proximo reinicio pedido (que vuelve al
# arbol vivo). Ver `gdtk-version status`.
# Cuelgue: un PID vivo sin avance de heartbeat se reporta como `hung`; terminarlo queda
# detras de GDTK_HEALTH_KILL_HUNG=1. Sin heartbeat no se promueve ni se mata (compatibilidad).
LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/gdtk"
RUN="${XDG_RUNTIME_DIR:-/tmp}"
QUIT="$RUN/gdtk-quit"     # el shell la crea al pedir Salir: termina aunque el cierre se caiga
FLAG="$RUN/gdtk-restart"  # el MCP lo crea antes de matar un shell colgado: no cuenta como caida
LOCK="$RUN/gdtk-supervisor.lock"
PROMOTE_AFTER="${GDTK_PROMOTE_AFTER:-20}"
VER="$(dirname "$0")/gdtk-version"
STORE="${GDTK_STORE:-${XDG_DATA_HOME:-$HOME/.local/share}/gdtk}"
export GDTK_STORE
# C2: heartbeat semantico. El helper valida pid + frescura del health.json atomico.
HEALTH_BIN="$(dirname "$0")/gdtk-health"
HEALTH_INTERVAL="${GDTK_HEALTH_INTERVAL:-1}"
HEALTH_TIMEOUT="${GDTK_HEALTH_TIMEOUT:-8}"
KILL_HUNG="${GDTK_HEALTH_KILL_HUNG:-0}"
mkdir -p "$LOGDIR"
pid=""
say() { echo "[supervisor] $*"; echo "$(date '+%F %T') $*" >>"$LOGDIR/supervisor.log"; }

# CONTENT vacio = arbol vivo. Solo se llena en fallback (ver mas abajo).
CONTENT=""

# Separa el binario del resto y guarda el --path original. El valor de --path se
# reemplaza por la version activa cuando hay store; si no, se conserva el original.
BIN="$1"; shift
EXTRA=""
ORIG_PATH=""
while [ $# -gt 0 ]; do
	case "$1" in
		--path) shift; [ $# -gt 0 ] && { ORIG_PATH="$1"; shift; }; continue;;
		*) EXTRA="$EXTRA $1";;
	esac
	shift
done

take_lock() {
	while ! mkdir "$LOCK" 2>/dev/null; do
		old=""
		[ -f "$LOCK/pid" ] && old="$(cat "$LOCK/pid" 2>/dev/null)"
		if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
			# Un supervisor de OTRA sesion de sway es un resto: su shell quedo colgado al
			# perder el display y su lock impedia arrancar la sesion nueva.
			old_sock="$(tr '\0' '\n' <"/proc/$old/environ" 2>/dev/null | sed -n 's/^SWAYSOCK=//p')"
			if [ -n "${SWAYSOCK:-}" ] && [ "$old_sock" != "$SWAYSOCK" ]; then
				say "supervisor viejo (pid $old) de otra sesion de sway: lo termino"
				old_shell="$(cat "$RUN/gdtk-shell.pid" 2>/dev/null)"
				kill "$old" 2>/dev/null
				[ -n "$old_shell" ] && kill -9 "$old_shell" 2>/dev/null
				sleep 1
				kill -9 "$old" 2>/dev/null
				rm -rf "$LOCK"
				continue
			fi
			say "ya hay un supervisor vivo (pid $old); no arranco otro"
			exit 0
		fi
		rm -rf "$LOCK"
	done
	echo $$ >"$LOCK/pid"
}

# Deskflow lo lanza el shell desacoplado (PPID 1): si sobrevive al shell, su enlace
# EIS apunta al shell muerto pero sigue conectado por TCP, y el servidor (bastion)
# deja el puntero "en" este equipo sin que nadie inyecte nada. Se termina apenas
# termina el shell; el shell siguiente lo relanza (y ya reapea restos al arrancar).
kill_deskflow() {
	pkill -u "$(id -u)" -x deskflow-core 2>/dev/null
	pkill -u "$(id -u)" -x deskflow 2>/dev/null
}

stop_now() {
	# El shell puede quedar colgado al perder el display: TERM y, si no basta, KILL.
	if [ -n "$pid" ]; then
		kill "$pid" 2>/dev/null
		sleep 1
		kill -9 "$pid" 2>/dev/null
	fi
	kill_deskflow
	rm -rf "$LOCK"
	exit 0
}

take_lock
trap stop_now HUP INT TERM
trap 'rm -rf "$LOCK"' EXIT
# Vigia: si muere el sway de esta sesion (cierre de sesion), terminar con el shell y
# salir, en vez de quedar vivo con el lock tomado.
if [ -n "${SWAYSOCK:-}" ]; then
	sup=$$
	( while [ -S "$SWAYSOCK" ] && kill -0 "$sup" 2>/dev/null; do sleep 5; done
	  kill -0 "$sup" 2>/dev/null && kill -TERM "$sup" ) &
fi

fails=0
while :; do
	[ -f "$LOGDIR/shell.log" ] && mv -f "$LOGDIR/shell.log" "$LOGDIR/shell.prev.log"
	rm -f "$FLAG" "$QUIT"
	safe=""
	if [ "$fails" -ge 2 ]; then
		safe="--video-driver GLES2"; export GDTK_SAFE="$fails"
		say "modo a prueba de fallos tras $fails caidas"
	else
		unset GDTK_SAFE
	fi
	launch_path="$ORIG_PATH"
	version=""
	if [ -n "$CONTENT" ]; then
		launch_path="$CONTENT/shell"
		version="$(basename "$CONTENT")"
		export GDTK_HOME="$CONTENT"
		export GDTK_FALLBACK="$version"
		say "FALLBACK: corriendo la copia guardada $version, NO el arbol vivo (reinicia el shell para volver)"
	else
		unset GDTK_HOME GDTK_FALLBACK
	fi
	if [ -n "$version" ]; then echo "fallback $version"; else echo "vivo $ORIG_PATH"; fi >"$LOGDIR/running-version"
	start=$(date +%s)
	say "arrancando${version:+ version $version} ($launch_path)"
	# tee por un fifo: el log queda en disco y la salida sigue llegando a quien lanzo la sesion.
	fifo="$RUN/gdtk-shell.$$.fifo"; rm -f "$fifo"; mkfifo "$fifo"
	tee "$LOGDIR/shell.log" <"$fifo" &
	tee_pid=$!
	# shellcheck disable=SC2086
	"$BIN" $safe $EXTRA --path "$launch_path" >"$fifo" 2>&1 &
	pid=$!
	echo "$pid" >"$RUN/gdtk-shell.pid"
	# Promocion a last_good_content: SOLO con progreso semantico observado del PID
	# correcto (C2). Un PID vivo o un heartbeat estancado no promueve. Sin heartbeat no
	# se promueve ni se mata (compatibilidad de arranque). El cuelgue se reporta; matarlo
	# requiere GDTK_HEALTH_KILL_HUNG=1.
	promoter=""
	if [ -x "$VER" ]; then
		(
			hb_seen=0; hb_last_seq=""; hb_adv=0; hb_hung=0; hb_promoted=0
			hb_last_adv="$(date +%s)"; hb_start="$(date +%s)"
			while kill -0 "$pid" 2>/dev/null; do
				[ "$(cat "$RUN/gdtk-shell.pid" 2>/dev/null)" = "$pid" ] || break
				line=""
				[ -x "$HEALTH_BIN" ] && line="$("$HEALTH_BIN" probe "$pid" 2>/dev/null || true)"
				state="$(printf '%s' "$line" | cut -f1)"
				seq="$(printf '%s' "$line" | cut -f2)"
				reload="$(printf '%s' "$line" | cut -f3)"
				now="$(date +%s)"
				case "$state" in
					ok)
						if [ "$reload" = ready ]; then
							if [ "$hb_seen" -eq 0 ]; then
								hb_seen=1; hb_last_adv="$now"
							elif [ -n "$seq" ] && [ -n "$hb_last_seq" ] \
							     && [ "$seq" -gt "$hb_last_seq" ] 2>/dev/null; then
								hb_adv=$((hb_adv + 1)); hb_last_adv="$now"
							fi
						fi
						hb_last_seq="$seq"
						;;
					absent|nounjq)
						# Sin heartbeat: compatibilidad, ni promocion ni muerte.
						hb_seen=0; hb_last_seq=""; hb_adv=0
						;;
					*) : ;;  # invalid/wrongpid/stale: no cuentan progreso
				esac
				# Cuelgue: hubo heartbeat valido y dejo de avanzar.
				if [ "$hb_seen" -eq 1 ] && [ $((now - hb_last_adv)) -ge "$HEALTH_TIMEOUT" ]; then
					if [ "$hb_hung" -eq 0 ]; then
						say "shell sin progreso semantico (hung): pid $pid"
						hb_hung=1
					fi
					if [ "$KILL_HUNG" = 1 ]; then
						say "GDTK_HEALTH_KILL_HUNG=1: termino el shell colgado (pid $pid)"
						kill "$pid" 2>/dev/null
						break
					fi
				fi
				# Promover: PID vivo + heartbeat del PID + >=2 avances + reload ready.
				if [ "$hb_promoted" -eq 0 ] && [ "$state" = ok ] && [ "$hb_seen" -eq 1 ] \
				   && [ "$reload" = ready ] && [ "$hb_adv" -ge 2 ] \
				   && [ $((now - hb_start)) -ge "$PROMOTE_AFTER" ]; then
					if [ -n "$version" ]; then
						if "$VER" good "$version" >/dev/null 2>&1; then
							say "version $version marcada buena (progreso semantico)"; hb_promoted=1
						fi
					else
						if "$VER" autogood >/dev/null 2>&1; then
							say "arbol vivo guardado como last_good (progreso semantico)"; hb_promoted=1
						else
							say "autogood fallo (preflight); no se promueve"
						fi
					fi
				fi
				sleep "$HEALTH_INTERVAL"
			done
		) &
		promoter=$!
	fi
	wait "$pid"; rc=$?
	pid=""
	kill_deskflow
	[ -n "$promoter" ] && kill "$promoter" 2>/dev/null
	# No usar `wait` sin argumentos: un hijo del shell (gvd, terminal, deskflow) puede
	# heredar el FIFO y mantener vivo al tee, dejando al supervisor colgado sin
	# relanzar el shell. Se cierra el tee explicitamente y se sigue.
	kill "$tee_pid" 2>/dev/null
	wait "$tee_pid" 2>/dev/null
	rm -f "$fifo" "$RUN/gdtk-shell.pid"

	# El cierre pedido por el usuario (QUIT) manda. En cambio un reinicio pedido
	# (rc=75 de recovery.restart, o el flag gdtk-restart que crea el MCP) DEBE
	# relanzar aunque el shell haya salido con rc=0: p. ej. si lo terminan con
	# SIGTERM en vez de SIGKILL. Antes rc=0 ganaba sobre el flag y el supervisor
	# cerraba la sesion en vez de relanzar.
	if [ -f "$QUIT" ]; then
		[ "$rc" -eq 0 ] || say "salida pedida; el cierre termino con rc=$rc"
		rm -f "$QUIT"; exit 0
	elif [ "$rc" -eq 75 ] || [ -f "$FLAG" ]; then
		say "reinicio pedido (rc=$rc)"; fails=0; CONTENT=""; unset GDTK_LAST_CRASH
		continue
	elif [ "$rc" -eq 0 ]; then
		exit 0
	fi
	crash="$LOGDIR/crash-$(date +%Y%m%d-%H%M%S).log"
	cp "$LOGDIR/shell.log" "$crash"
	ls -t "$LOGDIR"/crash-*.log | tail -n +11 | xargs -r rm -f
	# Red de seguridad: caidas seguidas del arbol vivo -> last_good (solo hasta el proximo
	# reinicio pedido). Una caida suelta no cambia de version.
	if [ -z "$CONTENT" ] && [ -x "$VER" ] && [ $(($(date +%s) - start)) -lt 60 ] && [ "$fails" -ge 1 ]; then
		lg="$(readlink -f "$STORE/last_good" 2>/dev/null || true)"
		if [ -n "$lg" ] && [ -d "$lg/shell" ]; then
			say "el arbol vivo cayo al arrancar 2 veces seguidas: uso last_good $(basename "$lg")"
			CONTENT="$lg"
		fi
	fi
	# Caidas seguidas = cada una a menos de 60 s de arrancar; si no, se empieza a contar de nuevo.
	if [ $(($(date +%s) - start)) -lt 60 ]; then fails=$((fails + 1)); else fails=1; fi
	say "el shell se cayo (rc=$rc, seguidas=$fails): $crash"
	export GDTK_LAST_CRASH="$crash"
	[ "$fails" -ge 5 ] && { say "demasiadas caidas, me rindo"; exit "$rc"; }
	sleep 1
done
