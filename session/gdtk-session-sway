#!/bin/sh
# Sesión de prueba: el shell a pantalla completa sobre sway en vez de cage.
# Frente a cage suma lápiz y touch (libinput), rotación (tecla de la X200 Tablet) y config de entrada.
# Deskflow anda por el portal RemoteDesktop propio del shell (libei), igual que en cage/X11.
HERE="$(cd "$(dirname "$0")/.." && pwd)"
. "$HERE/session/keyboard.sh"
. "$HERE/session/portal.sh"   # XDG_CURRENT_DESKTOP=gdtk para el portal RemoteDesktop
export GDTK_SESSION=wayland GDTK_HOME="$HERE"
# Scanout directo (P4 opción B, modules/wayland/scanout.c): la ventana fullscreen de
# la salida principal se presenta a sway sin pasar por la escena de Godot. Opt-in;
# GDTK_SCANOUT_DIRECT=0 lo desactiva (el motor interpreta 0/false como apagado).
export GDTK_SCANOUT_DIRECT="${GDTK_SCANOUT_DIRECT:-1}"
# Medición F0 (bench/f0_probe.sh): si existe el flag, el motor emite [FRT_PERF]/
# [FRT_GPU] (ms/frame del hilo de render). Sólo para profiling; se borra el archivo
# para volver al uso normal. Persistente (sobrevive reinicios) a propósito.
if [ -e "${XDG_RUNTIME_DIR:-/tmp}/gdtk-frt-perf" ] || [ -e "$HOME/.gdtk-frt-perf" ]; then
	export FRT_PERF=1
fi
# polkit, llavero, notificaciones y ~/.config/autostart (difiere hasta tener compositor).
"$HERE/session/autostart.sh"
# Sensores del Surface Pro 3 (acelerómetro) sin reactivar el táctil N-Trig dañado.
"$HERE/session/sensor-hub.sh" || true
if [ -z "$GDTK_GODOT" ]; then
	GDTK_GODOT="$HERE/bin/godot-gdtk"
	[ -x "$GDTK_GODOT" ] || GDTK_GODOT=/home/icarito/Proyectos/godot3-box3d/godot-dev/bin/godot.frt.opt.debug.x86_64.gdtklite
fi
export GDTK_GODOT
# Driver de video del shell: GLES3 por defecto; GLES2 es SÓLO fallback (el supervisor
# lo fuerza tras caídas repetidas, session/gdtk-supervisor). GDTK_VIDEO_DRIVER_FORCE
# fuerza uno a mano. Se ignora el GDTK_VIDEO_DRIVER=GLES2 que exportaba el .desktop viejo.
export GDTK_VIDEO_DRIVER="${GDTK_VIDEO_DRIVER_FORCE:-GLES3}"
export SDL_VIDEODRIVER=wayland SDL_VIDEO_WAYLAND_ALLOW_LIBDECOR=0
# Sin audio ni joysticks en el shell: sus hilos despiertan la CPU sin uso (el shell las vacía para las apps).
export SDL_AUDIODRIVER=dummy SDL_JOYSTICK_HIDAPI=0 SDL_HIDAPI_LIBUSB=0
exec sway -c "$HERE/session/sway.conf"
